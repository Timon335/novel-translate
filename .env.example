# === Database ===
# PostgreSQL connection string
# รูปแบบ: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/novel_translator

# === Ollama (local AI translation) ===
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# Limits and timeouts (optional)
FETCH_TIMEOUT_MS=30000
OLLAMA_TIMEOUT_MS=600000
TTS_TIMEOUT_MS=30000
MAX_HTML_BYTES=10485760
MAX_BATCH_SIZE=100
JOB_RETENTION_MS=3600000

# === Server ===
PORT=3000
